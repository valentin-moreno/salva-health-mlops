"""
Gestión de credenciales y variables de entorno.

Este módulo centraliza la lectura de las variables de entorno utilizadas
por el proyecto. De esta forma se evita exponer información sensible
dentro del código fuente y se facilita la configuración entre distintos
entornos de ejecución.

Autor: Valentín Moreno Vásquez
Proyecto: Prueba Técnica MLOps - Salva Health
"""

from pathlib import Path
import os

from dotenv import load_dotenv

# ============================================================================
# CARGA DEL ARCHIVO .env
# ============================================================================

PROJECT_ROOT = Path(__file__).resolve().parents[2]

load_dotenv(PROJECT_ROOT / "config" / ".env")
# VARIABLES DE ENTORNO

AZURE_STORAGE_CONNECTION_STRING = os.getenv("AZURE_STORAGE_CONNECTION_STRING")

AZURE_CONTAINER_NAME = os.getenv("AZURE_CONTAINER_NAME")
